<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Dark theme (primary) -->
    <Color x:Key="BgBase">#080C18</Color>
    <Color x:Key="BgSurface">#0D1117</Color>
    <Color x:Key="BgCard">#111827</Color>
    <Color x:Key="BgElevated">#1A2235</Color>
    <Color x:Key="SidebarBg">#0B1120</Color>
    <Color x:Key="BorderColor">#1E2D45</Color>

    <Color x:Key="AccentPurple">#7C3AED</Color>
    <Color x:Key="AccentBlue">#3B82F6</Color>

    <Color x:Key="TextPrimary">#F1F5F9</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextMuted">#64748B</Color>

    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>

    <Color x:Key="DiffAddedBg">#052E16</Color>
    <Color x:Key="DiffRemovedBg">#2D0707</Color>
    <Color x:Key="DiffModifiedBg">#2D2007</Color>

    <!-- Semantic aliases used by controls -->
    <Color x:Key="PageBackgroundColor">#080C18</Color>
    <Color x:Key="CardBackgroundColor">#111827</Color>
    <Color x:Key="PrimaryColor">#7C3AED</Color>
    <Color x:Key="PrimaryTextColor">#F1F5F9</Color>
    <Color x:Key="SecondaryTextColor">#94A3B8</Color>

</ResourceDictionary>
