<UserControl x:Class="SprintForge.Wpf.Views.SrsGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SprintForge.Wpf.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Requirements" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Retail Banking Platform  ›  Account Management"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding JiraProjectKey, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Content="Clear" Command="{Binding ClearCommand}"
                        Style="{StaticResource OutlineButton}" Padding="12,8"/>
            </StackPanel>
        </Grid>

        <!-- ── Panel labels ────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="1. Input Requirements" FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Grid.Column="2" Text="2. AI Generated SRS (Preview)" FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Grid.Column="4" Text="3. Diff Viewer" FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Grid.Column="6" Text="Review &amp; Submit" FontSize="13" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>

        <!-- ── Three panels + sidebar ──────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Panel 1: Input -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Mini toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,0">
                        <Button Content="B" Style="{StaticResource OutlineButton}" Padding="8,4" FontWeight="Bold" Margin="0,0,4,0"/>
                        <Button Content="I" Style="{StaticResource OutlineButton}" Padding="8,4" FontStyle="Italic" Margin="0,0,4,0"/>
                        <Button Content="•" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="&lt;/&gt;" Style="{StaticResource OutlineButton}" Padding="8,4"
                                FontFamily="Cascadia Code, Consolas, monospace"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             Padding="12" FontSize="13"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             VerticalAlignment="Stretch"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Margin="12,8" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding InputText.Length, StringFormat='{}{0} chars'}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="▶ Generate"
                                Command="{Binding GenerateCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="16,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Panel 2: AI Preview -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Loading indicator -->
                    <Border Grid.Row="0" Background="{StaticResource BgElevatedBrush}" Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="⟳  Generating SRS via AI…" FontSize="13"
                                   Foreground="{StaticResource AccentPurpleBrush}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <TextBlock Text="{Binding GeneratedPreview}"
                                   FontSize="13"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GeneratedPreview}" Value="">
                                            <Setter Property="Text" Value="AI-generated SRS will appear here…"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Panel 3: Diff Viewer -->
            <Border Grid.Column="4"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <!-- Column headers -->
                    <Grid DockPanel.Dock="Top" Background="{StaticResource BgElevatedBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Req.ID" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}" Padding="10,7"/>
                        <TextBlock Grid.Column="1" Text="Requirement" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}" Padding="6,7"/>
                        <TextBlock Grid.Column="2" Text="Change" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}" Padding="6,7"/>
                    </Grid>

                    <!-- Empty state -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Generate SRS to see diff…"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiffLines.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiffLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiffLine}">
                                    <Border x:Name="RowBorder" Padding="0,1" Margin="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ReqId}"
                                                       FontSize="11" FontFamily="Cascadia Code, Consolas, monospace"
                                                       Foreground="{StaticResource TextMutedBrush}" Padding="10,6"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Requirement}"
                                                       FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" Padding="6"/>
                                            <!-- Change type badge -->
                                            <Border Grid.Column="2" x:Name="Badge"
                                                    CornerRadius="3" Padding="5,2" Margin="4,4,4,4"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{StaticResource BgElevatedBrush}">
                                                <TextBlock x:Name="BadgeText" Text="{Binding ChangeType}"
                                                           FontSize="10" FontWeight="Medium"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ChangeType}" Value="Added">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#052E16"/>
                                            <Setter TargetName="Badge" Property="Background" Value="#14532D"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#4ADE80"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChangeType}" Value="Modified">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#2D2007"/>
                                            <Setter TargetName="Badge" Property="Background" Value="#451A00"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#FCD34D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChangeType}" Value="Removed">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#2D0707"/>
                                            <Setter TargetName="Badge" Property="Background" Value="#450A0A"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#F87171"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Sidebar: review & submit -->
            <Border Grid.Column="6"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Review Status" FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                    <!-- Reviewer -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource AccentPurpleBrush}"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding ReviewerName}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Solution Architect" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status badge -->
                    <Border Background="#451A00" CornerRadius="4" Padding="8,5" Margin="0,0,0,16"
                            HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#451A00"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSubmitForApproval}" Value="True">
                                        <Setter Property="Background" Value="#052E16"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="12" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Pending Generation"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanSubmitForApproval}" Value="True">
                                            <Setter Property="Text" Value="Ready to Submit"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Impacted services -->
                    <TextBlock Text="Impacted Services" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="• Account Service" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="• Payment Service" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="• Notification Service" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderColorBrush}" Margin="0,0,0,16"/>

                    <!-- Submit button -->
                    <Button Content="Submit for Approval →"
                            Command="{Binding SubmitForApprovalCommand}"
                            IsEnabled="{Binding CanSubmitForApproval}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,10" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Sends to Approvals Center. No write until approved."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Action bar ───────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,1,0,0"
                Margin="-24,12,-24,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="▶  Generate SRS"
                            Command="{Binding GenerateCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Submit for Approval →"
                            Command="{Binding SubmitForApprovalCommand}"
                            IsEnabled="{Binding CanSubmitForApproval}"
                            Style="{StaticResource OutlineButton}" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
