<UserControl x:Class="SprintForge.Wpf.Views.ApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SprintForge.Wpf.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Approvals Center" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Background="#3B1F6E" CornerRadius="12" Padding="10,4"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PendingCount, StringFormat='{}{0} Pending'}"
                               FontSize="12" Foreground="{StaticResource AccentPurpleBrush}"
                               FontWeight="Medium"/>
                </Border>
            </StackPanel>

            <Button Grid.Column="1" Content="Approve All"
                    Command="{Binding ApproveAllCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,8" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="↻ Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource OutlineButton}" Padding="12,8"/>
        </Grid>

        <!-- ── Tab strip ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Command="{Binding ShowPendingTabCommand}" Padding="16,8" Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Pending">
                                <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="Pending"/>
            </Button>
            <Button Command="{Binding ShowHistoryTabCommand}" Padding="16,8">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="History">
                                <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="History"/>
            </Button>
        </StackPanel>

        <!-- ── Main area: list + detail ────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- List panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ListBox ItemsSource="{Binding CurrentItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{StaticResource BgElevatedBrush}"
                                                BorderBrush="{StaticResource BorderColorBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding ModuleTag}" FontSize="11"
                                                       Foreground="{StaticResource AccentPurpleBrush}"/>
                                        </Border>
                                        <Border x:Name="StatusChip" Margin="8,0,0,0"
                                                CornerRadius="4" Padding="6,2" Background="#451A00">
                                            <TextBlock x:Name="StatusText" Text="{Binding Status}"
                                                       FontSize="11" Foreground="{StaticResource WarningBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OperationDescription}"
                                               FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding QueuedAt, StringFormat='Queued {0:HH:mm dd MMM}'}"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                    <Setter TargetName="StatusChip" Property="Background" Value="#052E16"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                    <Setter TargetName="StatusChip" Property="Background" Value="#2D0707"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Detail pane -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <!-- Empty state -->
                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            Select an item from the list to review.
                        </TextBlock>

                        <!-- Detail content (when item selected) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding SelectedItem.OperationDescription}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <!-- Meta row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="{StaticResource BgElevatedBrush}"
                                        BorderBrush="{StaticResource BorderColorBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedItem.ModuleTag}"
                                               FontSize="12" Foreground="{StaticResource AccentPurpleBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedItem.QueuedAt, StringFormat='Queued {0:dd MMM yyyy HH:mm}'}"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Proposed value -->
                            <TextBlock Text="Proposed Value" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource BgElevatedBrush}"
                                    BorderBrush="{StaticResource BorderColorBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding SelectedItem.ProposedValueJson}"
                                           FontSize="12" FontFamily="Cascadia Code, Consolas, monospace"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- AI Explanation -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.AiExplanation}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="AI Explanation" FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border Background="#1A1440" BorderBrush="#3B1F6E"
                                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding SelectedItem.AiExplanation}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- Affected files -->
                            <TextBlock Text="Affected Files" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedItem.AffectedFiles}" Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   FontFamily="Cascadia Code, Consolas, monospace"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✓  Approve"
                                        Command="{Binding ApproveCommand}"
                                        CommandParameter="{Binding SelectedItem}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="20,10" Margin="0,0,8,0"/>
                                <Button Content="✗  Reject"
                                        Command="{Binding RejectCommand}"
                                        CommandParameter="{Binding SelectedItem}"
                                        Style="{StaticResource OutlineButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Padding="20,10"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Status bar ───────────────────────────────────────────── -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="12" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
