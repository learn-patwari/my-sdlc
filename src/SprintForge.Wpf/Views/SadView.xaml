<UserControl x:Class="SprintForge.Wpf.Views.SadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SprintForge.Wpf.ViewModels"
             Background="{StaticResource BgSurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb + header -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Architecture" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text=" › " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text=" › " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding ServiceName}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Generate SAD" Style="{StaticResource PrimaryButton}"
                        Command="{Binding GenerateCommand}"/>
            </Grid>
        </Border>

        <!-- Tab strip -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Architecture View" Command="{Binding SelectTabCommand}"
                        CommandParameter="Architecture" Padding="12,8" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Architecture">
                                    <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Document Preview" Command="{Binding SelectTabCommand}"
                        CommandParameter="Document" Padding="12,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Document">
                                    <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main 3-panel content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Component tree -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10,12,8"
                            BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Component Tree" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <ListBox ItemsSource="{Binding FlatTree}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                             Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2D1B69"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FlatNode}">
                                <Border x:Name="NodeRow" Padding="8,5" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="{Binding IndentWidth}" Background="Transparent"/>
                                        <TextBlock x:Name="NodeIcon" Text="{Binding Icon}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NodeLabel" Text="{Binding Name}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="NodeLabel" Property="Foreground"
                                                Value="{StaticResource AccentPurpleBrush}"/>
                                        <Setter TargetName="NodeLabel" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="NodeLabel" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Center: Architecture diagram / status -->
            <Border Grid.Column="1" Background="{StaticResource BgSurfaceBrush}" Padding="16">
                <Grid>
                    <!-- Architecture tab -->
                    <Grid x:Name="ArchPanel">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Architecture">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Architecture Diagram" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,24"/>
                            <!-- Static architecture diagram using Canvas -->
                            <Canvas Width="460" Height="310">
                                <!-- Connection lines -->
                                <Line X1="230" Y1="46" X2="95"  Y2="90" Stroke="#1E2D45" StrokeThickness="1.5"/>
                                <Line X1="230" Y1="46" X2="365" Y2="90" Stroke="#1E2D45" StrokeThickness="1.5"/>
                                <Line X1="95"  Y1="126" X2="95"  Y2="170" Stroke="#1E2D45" StrokeThickness="1.5"/>
                                <Line X1="95"  Y1="126" X2="80"  Y2="250" Stroke="#1E2D45" StrokeThickness="1.5" StrokeDashArray="4,3"/>
                                <Line X1="155" Y1="108" X2="220" Y2="250" Stroke="#1E2D45" StrokeThickness="1.5" StrokeDashArray="4,3"/>
                                <Line X1="365" Y1="126" X2="360" Y2="250" Stroke="#1E2D45" StrokeThickness="1.5"/>

                                <!-- API Gateway -->
                                <Border Canvas.Left="155" Canvas.Top="10" Width="150" Height="36"
                                        Background="#134e4a" BorderBrush="#0f766e"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="API Gateway" Foreground="#2dd4bf"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Payment Service (highlighted) -->
                                <Border Canvas.Left="20" Canvas.Top="90" Width="150" Height="36"
                                        Background="#2D1B69" BorderBrush="{StaticResource AccentPurpleBrush}"
                                        BorderThickness="1.5" CornerRadius="6">
                                    <TextBlock Text="Payment Service" Foreground="White"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Notification Service -->
                                <Border Canvas.Left="290" Canvas.Top="90" Width="150" Height="36"
                                        Background="#1A2235" BorderBrush="#1E2D45"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="Notification Service" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Account Service -->
                                <Border Canvas.Left="20" Canvas.Top="170" Width="150" Height="36"
                                        Background="#1A2235" BorderBrush="#1E2D45"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="Account Service" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- PostgreSQL -->
                                <Border Canvas.Left="20" Canvas.Top="250" Width="120" Height="36"
                                        Background="#0f172a" BorderBrush="#334155"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="PostgreSQL" Foreground="#94a3b8"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Redis Cache -->
                                <Border Canvas.Left="165" Canvas.Top="250" Width="110" Height="36"
                                        Background="#0f172a" BorderBrush="#334155"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="Redis Cache" Foreground="#94a3b8"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Kafka -->
                                <Border Canvas.Left="300" Canvas.Top="250" Width="120" Height="36"
                                        Background="#1c1206" BorderBrush="#92400e"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="Kafka" Foreground="#f59e0b"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </StackPanel>
                    </Grid>

                    <!-- Document preview tab -->
                    <ScrollViewer x:Name="DocTabPanel" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Document">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <TextBlock Text="{Binding DocumentPreview}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="13" TextWrapping="Wrap" Padding="4"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Document info + status -->
            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1,0,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Generated Files" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6"
                            BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                            Padding="8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="payment-service-sad.md"   Foreground="{StaticResource AccentBlueBrush}" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="payment-service-diagram.xml" Foreground="{StaticResource AccentBlueBrush}" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="payment-service-api.yaml"  Foreground="{StaticResource AccentBlueBrush}" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="draw-io-model.xml"         Foreground="{StaticResource AccentBlueBrush}" FontSize="12" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <Separator Background="{StaticResource BorderColorBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="Version" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="v1.0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,8"/>

                    <TextBlock Text="Last updated" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="28 Jul 2026" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16"/>

                    <Button Content="Submit for Approval" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"/>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
