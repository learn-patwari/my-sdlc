<Window x:Class="SprintForge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SprintForge.Wpf.ViewModels"
        Title="SprintForge Beta" Height="768" Width="1280"
        Background="{StaticResource BgBaseBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect fill='%237C3AED' width='64' height='64' rx='12'/%3E%3Ctext x='32' y='48' font-size='36' font-weight='bold' fill='white' text-anchor='middle'%3ES%3C/text%3E%3C/svg%3E">
    <Grid>
        <!-- ── Top bar (56px) ────────────────────────────────────────── -->
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource BgSurfaceBrush}" Grid.Row="0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="SprintForge" Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Search + Profile -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Right">
                <TextBlock Text="🔔" FontSize="18" Margin="0,0,16,0" Cursor="Hand"/>
                <TextBlock Text="👤" FontSize="18" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- ── Main shell (nav + content) ────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav rail (220px) -->
            <Grid Background="{StaticResource BgSidebarBrush}" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo placeholder -->
                <Border Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="S" Foreground="{StaticResource AccentPurpleBrush}"
                               FontSize="32" FontWeight="Bold" TextAlignment="Center"/>
                </Border>

                <!-- Nav items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="{Binding IsActive, Converter={x:Static BoolToVisConverter}, ConverterParameter=AccentPurpleBrush}"
                                        Margin="0,4" Padding="12,10" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Label}" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Collapse button -->
                <Button Grid.Row="2" Content="← Collapse" Style="{StaticResource OutlineButton}"
                        Margin="12" HorizontalAlignment="Stretch" Padding="12,8" FontSize="12"/>
            </Grid>

            <!-- Content area -->
            <Border Grid.Column="1" Background="{StaticResource BgSurfaceBrush}">
                <ContentPresenter Content="{Binding CurrentPage}" Margin="24"/>
            </Border>
        </Grid>
    </Grid>
</Window>
