<Window x:Class="SprintForge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SprintForge.Wpf.ViewModels"
        Title="SprintForge Beta" Height="768" Width="1280"
        Background="{StaticResource BgBaseBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar ──────────────────────────────────────────────────── -->
        <Grid Background="{StaticResource BgSurfaceBrush}" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand wordmark (aligns with nav) -->
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Border Background="{StaticResource AccentPurpleBrush}" CornerRadius="6"
                        Width="28" Height="28" Margin="0,0,8,0">
                    <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="WordmarkText" Text="SprintForge"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="Bold" FontSize="15" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Centre: search hint -->
            <TextBlock Grid.Column="1" Text="Ctrl+F to search…"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Right: notification bell + profile -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                <!-- Notification bell -->
                <Button ToolTip="Notifications" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0"
                        Foreground="{StaticResource TextSecondaryBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource BgElevatedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="🔔" FontSize="18"/>
                </Button>

                <!-- Profile / user -->
                <Button ToolTip="Profile" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4"
                        Foreground="{StaticResource TextSecondaryBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource BgElevatedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentPurpleBrush}" CornerRadius="999"
                                Width="26" Height="26" Margin="0,0,6,0">
                            <TextBlock Text="A" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Akshay" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Main shell (nav + content) ────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Width is Auto so the nav Border drives the column width -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav rail — Width toggled via DataTrigger -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavExpanded}" Value="False">
                                <Setter Property="Width" Value="52"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nav items -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding NavItems}" Margin="8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                    <Button Command="{Binding DataContext.NavigateCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" BorderThickness="0"
                                            Margin="0,2" Padding="10,9" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" ToolTip="{Binding Label}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Left"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background"
                                                                            Value="{StaticResource BgElevatedBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="15"
                                                       VerticalAlignment="Center" Width="22"
                                                       HorizontalAlignment="Center"/>
                                            <!-- Label hidden when nav is collapsed -->
                                            <TextBlock Text="{Binding Label}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsNavExpanded,
                                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Collapse toggle at bottom -->
                    <Button Grid.Row="1" Command="{Binding ToggleNavCommand}"
                            Cursor="Hand" BorderThickness="0"
                            Margin="8,4,8,8" Padding="10,8" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{StaticResource BorderColorBrush}"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"
                                                            Value="{StaticResource BgElevatedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" VerticalAlignment="Center" Width="22"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="◀"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNavExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Collapse"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNavExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Content area -->
            <Border Grid.Column="1" Background="{StaticResource BgSurfaceBrush}">
                <ContentPresenter Content="{Binding CurrentPage}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
